<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gerçek MariaDB'ye karşı çalışan entegrasyon testleri (tests/php-integration/).
  Normal birim testlerden (phpunit.xml.dist -> tests/php/, SQLite in-memory,
  hızlı, izole) BİLEREK ayrı bir yapılandırma dosyasıdır: farklı testDir,
  farklı cache klasörü, farklı composer script'i (composer test:integration).
  Ön koşul: `docker compose up -d db` (veya web+db) çalışıyor olmalı — bkz.
  README "Testler" / "Entegrasyon testleri" bölümü.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.integration.cache">
    <testsuites>
        <testsuite name="php-integration">
            <directory>tests/php-integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
