# GAÜN Kampüs Haritası — production örnek ortam dosyası
# Sunucuda proje köküne `.env` adıyla kopyalayın ve tüm secret değerleri değiştirin.

COMPOSE_PROJECT_NAME=gaunharita
APP_PORT=8080
APP_DEBUG=false
TZ=Europe/Istanbul

DB_NAME=gau_kampus
DB_READ_USER=gau_read
DB_READ_PASS=CHANGE_ME_read_32_chars
DB_WRITE_USER=gau_write
DB_WRITE_PASS=CHANGE_ME_write_32_chars
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_48_chars
ADMIN_AUDIT_SALT=CHANGE_ME_random_hex_64_chars

# Varsayılan: public OSRM demo servisi. SLA/yoğunluk için self-hosted OSRM önerilir.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_WALK_PROFILE=foot
OSRM_DRIVE_PROFILE=driving
OSRM_TIMEOUT_MS=4000

# Self-hosted OSRM kullanacaksanız tarayıcının erişebileceği URL'leri girin.
# OSRM_DRIVE_BASE_URL=https://harita.example.com/osrm-car
# OSRM_WALK_BASE_URL=https://harita.example.com/osrm-foot

# Dashboard sağlık kontrolü için web container içinden erişilecek URL'ler.
# Boşsa OSRM_BASE_URL kontrol edilir.
OSRM_DRIVE_HEALTH_URL=
OSRM_WALK_HEALTH_URL=

SYNC_RUN_AT=05:10
SYNC_RUN_ON_START=false
