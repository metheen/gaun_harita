# GAÜN Kampüs Haritası — ortam değişkenleri şablonu
#
# Bu dosyayı `.env` olarak kopyalayın: `cp .env.example .env`
# `.env` sürüm kontrolüne ALINMAZ (bkz. .gitignore).
#
# Aşağıdaki dev_* değerleri YALNIZCA yerel Docker geliştirme ortamı içindir
# (docker/init/01-users.sql ile eşleşir, DB dışarıya yalnız localhost:3307'den
# açıktır). ÜRETİMDE üçünü de güçlü, benzersiz parolalarla değiştirin ve DB
# hesaplarını kendiniz oluşturun (bkz. README "Üretim notları").

DB_HOST=db
DB_NAME=gau_kampus

# Halka açık ön yüz: yalnızca okuma yetkili hesap (en az yetki ilkesi).
DB_READ_USER=gau_read
DB_READ_PASS=dev_read_pw

# Yönetim paneli: okuma-yazma yetkili hesap.
DB_WRITE_USER=gau_write
DB_WRITE_PASS=dev_write_pw

# Yalnızca Docker Compose'un "db" servisi İLK KEZ oluşturulurken kullanılır
# (MariaDB root parolası). Üretimde güçlü, rastgele bir değer verin — asla
# DB_READ_PASS/DB_WRITE_PASS ile aynı olmasın (ör. `openssl rand -hex 24`).
MYSQL_ROOT_PASSWORD=dev_root_pw

# audit_log.php IP hash'lemesi için tuz (salt). Boş bırakılırsa DB_WRITE_PASS'e,
# o da yoksa sabit bir yedek değere düşülür — üretimde MUTLAKA kendi rastgele
# değerinizi verin (ör. `openssl rand -hex 32`), aksi halde IP hash'leri
# tahmin edilebilir hale gelir.
ADMIN_AUDIT_SALT=

# Üretimde false bırakın; hata ayrıntılarını gizler.
APP_DEBUG=false

# Rota servisi (OSRM). Base URL /route/v1 olmadan verilmelidir.
# Genel demo sunucusu (router.project-osrm.org) yalnızca araç verisiyle
# çalışır ve profili yok sayar; yaya rotası isterseniz aşağıdaki
# OSRM_WALK_BASE_URL/OSRM_DRIVE_BASE_URL ile kendi barındırdığınız
# osrm-car/osrm-foot servislerini kullanın (bkz. docker/osrm/, README).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_WALK_PROFILE=foot
OSRM_DRIVE_PROFILE=driving
OSRM_TIMEOUT_MS=4000

# Boş bırakılırsa yukarıdaki OSRM_BASE_URL kullanılır. Kendi OSRM'inizi
# kurduysanız (docker compose run --rm osrm-download && docker compose run
# --rm osrm-process && docker compose up -d osrm-car osrm-foot) doldurun:
# OSRM_DRIVE_BASE_URL=http://localhost:5001
# OSRM_WALK_BASE_URL=http://localhost:5002

# Docker sync servisi: GAÜN kaynaklarını her gün Türkiye saatiyle erken saatte yeniler.
TZ=Europe/Istanbul
SYNC_RUN_AT=05:10
SYNC_RUN_ON_START=false
